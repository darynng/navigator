<?xml version="1.0"?>
<robot name="robot">

  <!-- ================= MATERIALS ================= -->
  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>

  <material name="blue">
    <color rgba="0.2 0.2 1 1"/>
  </material>

  <material name="gray">
    <color rgba="0.278 0.294 0.549 0.5"/>
  </material>

  <material name="black">
    <color rgba="0.05 0.05 0.05 1"/>
  </material>

  <!-- ================= BASE LINK ================= -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <geometry>
        <box size="0.95 0.35 0.2"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <geometry>
        <box size="0.7 0.55 0.2"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <mass value="60"/>
      <inertia
        ixx="1.7125" ixy="0" ixz="0"
        iyy="2.65"   iyz="0"
        izz="3.9625"/>
    </inertial>
  </link>

  <!-- ================= WHEELS ================= -->
  <!-- Common wheel parameters:
       radius = 0.165
       length  = 0.06
       mass   = 3.0
       inertia:
         ixx = iyy = 0.02131875
         izz = 0.0408375
  -->

  <!-- Front Left Wheel -->
  <link name="front_left_wheel">
    <visual>
      <origin xyz="0.2 -0.15 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.165" length="0.06"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <origin xyz="0.2 -0.15 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.165" length="0.06"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.2 -0.15 0" rpy="1.5708 0 0"/>
      <mass value="3.0"/>
      <inertia
        ixx="0.02131875" ixy="0" ixz="0"
        iyy="0.02131875" iyz="0"
        izz="0.0408375"/>
    </inertial>
  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <origin xyz="0.2 -0.15 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Front Right Wheel -->
  <link name="front_right_wheel">
    <visual>
      <origin xyz="0.2 0.15 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.165" length="0.06"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <origin xyz="0.2 0.15 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.165" length="0.06"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.2 0.15 0" rpy="1.5708 0 0"/>
      <mass value="3.0"/>
      <inertia
        ixx="0.02131875" ixy="0" ixz="0"
        iyy="0.02131875" iyz="0"
        izz="0.0408375"/>
    </inertial>
  </link>

  <joint name="front_right_wheel_joint" type="continuous">
    <origin xyz="0.2 0.15 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Rear Left Wheel -->
  <link name="rear_left_wheel">
    <visual>
      <origin xyz="-0.2 -0.15 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.165" length="0.06"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <origin xyz="-0.2 -0.15 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.165" length="0.06"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="-0.2 -0.15 0" rpy="1.5708 0 0"/>
      <mass value="3.0"/>
      <inertia
        ixx="0.02131875" ixy="0" ixz="0"
        iyy="0.02131875" iyz="0"
        izz="0.0408375"/>
    </inertial>
  </link>

  <joint name="rear_left_wheel_joint" type="continuous">
    <origin xyz="-0.2 -0.15 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Rear Right Wheel -->
  <link name="rear_right_wheel">
    <visual>
      <origin xyz="-0.2 0.15 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.165" length="0.06"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <origin xyz="-0.2 0.15 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.165" length="0.06"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="-0.2 0.15 0" rpy="1.5708 0 0"/>
      <mass value="3.0"/>
      <inertia
        ixx="0.02131875" ixy="0" ixz="0"
        iyy="0.02131875" iyz="0"
        izz="0.0408375"/>
    </inertial>
  </link>

  <joint name="rear_right_wheel_joint" type="continuous">
    <origin xyz="-0.2 0.15 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ================= CAMERA ================= -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.2 0.03"/>
      </geometry>
      <material name="white"/>
    </visual>

    <collision>
      <origin xyz="0.45 0 0.125" rpy="0 0 0"/>
      <geometry>
       <box size="0.1 0.2 0.03"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.45 0 0.125" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia
        ixx="0.000375" ixy="0" ixz="0"
        iyy="0.0003075" iyz="0"
        izz="0.0003075"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <origin xyz="0.45 0 0.125" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="camera_link"/>
  </joint>
   
    <!-- Due to a quirk of how cameras work, an extra joint/link is required to create an
         "optical frame" for the sensor. -->

    <joint name="camera_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="-1.571 0 -1.571" />
        <parent link="camera_link" />
        <child link="camera_link_optical" />
    </joint>

    <link name="camera_link_optical"></link>
</robot>

