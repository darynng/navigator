<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="robot">

    <!-- ================= CHASSIS ================= -->
    <link name="base_link">
      <pose>0 0 0.3 0 0 0</pose>
      <visual name="base_visual">
        <geometry>
          <box>
            <size>0.95 0.3 0.18</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.3 1</ambient>
          <diffuse>0.1 0.3 1.0 1</diffuse>
        </material>
      </visual>

      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.95 0.27 0.2</size>
          </box>
        </geometry>
      </collision>

      <inertial>
        <mass>60</mass>
        <inertia>
          <ixx>1.7125</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>2.65</iyy>
          <iyz>0</iyz>
          <izz>3.9625</izz>
        </inertia>
      </inertial>
    </link>

    <!-- ================= WHEELS ================= -->
    <!-- Front Left Wheel -->
    <link name="front_left_wheel">
      <pose>0.2 -0.18 0.2 1.5708 0 0</pose>
      <visual name="front_left_visual">
        <geometry>
          <cylinder>
            <radius>0.165</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
      </visual>
      <collision name="front_left_collision">
        <geometry>
          <cylinder>
            <radius>0.165</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
      </collision>
      <inertial>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.02131875</ixx>
          <iyy>0.02131875</iyy>
          <izz>0.0408375</izz>
        </inertia>
      </inertial>
    </link>
    
    <joint name="front_left_wheel_joint" type="revolute">
      <pose>0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>front_left_wheel</child>
      <axis>
    	<xyz>0 0 1</xyz> 
    	<limit>
    	  <lower>-1e16</lower> <upper>1e16</upper>
      	  <effort>100</effort> 
      	  <velocity>10</velocity>
    	</limit>
      </axis>
    </joint>

    <!-- Front Right Wheel -->
    <link name="front_right_wheel">
      <pose>0.2 0.18 0.2 1.5708 0 0</pose>
      <visual name="front_right_visual">
        <geometry>
          <cylinder>
            <radius>0.165</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
      </visual>
      <collision name="front_right_collision">
        <geometry>
          <cylinder>
            <radius>0.165</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
      </collision>
      <inertial>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.02131875</ixx>
          <iyy>0.02131875</iyy>
          <izz>0.0408375</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <!-- Rear Left Wheel -->
    <link name="rear_left_wheel">
      <pose>-0.2 -0.18 0.2 1.5708 0 0</pose>
      <visual name="rear_left_visual">
        <geometry>
          <cylinder>
            <radius>0.165</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
      </visual>
      <collision name="rear_left_collision">
        <geometry>
          <cylinder>
            <radius>0.165</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
      </collision>
      <inertial>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.02131875</ixx>
          <iyy>0.02131875</iyy>
          <izz>0.0408375</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <!-- Rear Right Wheel -->
    <link name="rear_right_wheel">
      <pose>-0.2 0.18 0.2 1.5708 0 0</pose>
      <visual name="rear_right_visual">
        <geometry>
          <cylinder>
            <radius>0.165</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
      </visual>
      <collision name="rear_right_collision">
        <geometry>
          <cylinder>
            <radius>0.165</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
      </collision>
      <inertial>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.02131875</ixx>
          <iyy>0.02131875</iyy>
          <izz>0.0408375</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>
    
    <!-- ================= CAMERA ================= -->
    <link name="camera_depth_frame"/>
    
    <joint name="camera_depth_joint" type="fixed">
      <parent>camera_link</parent>
      <child>camera_depth_frame</child>
      <pose relative_to="camera_link">0 0 0 -1.571 0 -1.571</pose>
    </joint>

    <link name="camera_link">
      <pose>0.4 0 0.4 0 0 0</pose>
      <visual name="camera_visual">
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
        <geometry>
          <box>
            <size>0.04 0.08 0.04</size>
          </box>
        </geometry>
      </visual>

      <collision name="camera_collision">
        <geometry>
          <box>
            <size>0.1 0.13 0.03</size>
          </box>
        </geometry>
      </collision>

      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.000375</ixx>
          <iyy>0.0003075</iyy>
          <izz>0.0003075</izz>
        </inertia>
      </inertial>
      
      <sensor name="color_camera" type="camera">
	<pose>0.35 0 0.4 0 0 0</pose>
	<always_on>1</always_on>
	<update_rate>30</update_rate>
	<visualize>1</visualize>
	<topic>color_camera</topic>
		
	<camera name="d435i">
		<horizontal_fov>1.21126</horizontal_fov>
		<image>
			<width>640</width>
			<height>480</height>
			<format>RGB_INT8</format>
		</image>
		<clip>
			<near>0.1</near>
			<far>50</far>
		</clip>
		<noise>
			<type>gaussian</type>
			<mean>0</mean>
			<stddev>0.007</stddev>
		</noise>
	</camera>
      </sensor>
      
     <sensor name="depth_camera" type="depth_camera">
        <visualize>1</visualize>
        <update_rate>30</update_rate>
        <pose>0.35 0 0.4 0 0 0</pose>
        <topic>depth_camera</topic>
        <always_on>1</always_on>

        <camera>
		<horizontal_fov>1</horizontal_fov>
		<image>
			<width>640</width>
			<height>480</height>
		</image>
		<clip>
			 <near>0.1</near>
			 <far>50</far>
		</clip>
		<noise>
			 <type>gaussian</type>
			 <mean>0</mean>
			 <stddev>0.1</stddev>
		</noise>
        </camera>
        
     </sensor>
     
    </link>
    
    <!-- IMU SENSOR -->
    
    <joint name='imu_joint' type='fixed'>
	  <parent>base_link</parent>
	  <child>imu_link</child>
	  <pose relative_to="base_link">0.0 0.0 0.01 0 0 0</pose>
    </joint>

    <link name='imu_link'>
	  <pose relative_to="imu_joint"/>
	  <visual name="imu_link_visual">
	    <geometry>
	      <box><size>
		0.1 0.1 0.1
	      </size></box>
	    </geometry>
	  </visual>

	  <collision name="imu_link_collision">
	    <geometry>
	      <box><size>
		0.1 0.1 0.1
	      </size></box>
	    </geometry>
	  </collision>

	  <xacro:box_inertia m="0.1" w="0.1" d="0.1" h="0.1"/>

	  <sensor name="imu_sensor" type="imu">
	    <always_on>true</always_on>
	    <update_rate>100</update_rate>
	    <visualize>true</visualize>
	    <topic>imu</topic>
	    <gz_frame_id>imu_link</gz_frame_id>
	    <imu>
	      <angular_velocity>
		<x>
		  <noise type="gaussian">
		    <mean>0.0</mean>
		    <stddev>2e-4</stddev>
		    <bias_mean>0.0000075</bias_mean>
		    <bias_stddev>0.0000008</bias_stddev>
		  </noise>
		</x>
		<y>
		  <noise type="gaussian">
		    <mean>0.0</mean>
		    <stddev>2e-4</stddev>
		    <bias_mean>0.0000075</bias_mean>
		    <bias_stddev>0.0000008</bias_stddev>
		  </noise>
		</y>
		<z>
		  <noise type="gaussian">
		    <mean>0.0</mean>
		    <stddev>2e-4</stddev>
		    <bias_mean>0.0000075</bias_mean>
		    <bias_stddev>0.0000008</bias_stddev>
		  </noise>
		</z>
	      </angular_velocity>
	      <linear_acceleration>
		<x>
		  <noise type="gaussian">
		    <mean>0.0</mean>
		    <stddev>1.7e-2</stddev>
		    <bias_mean>0.1</bias_mean>
		    <bias_stddev>0.001</bias_stddev>
		  </noise>
		</x>
		<y>
		  <noise type="gaussian">
		    <mean>0.0</mean>
		    <stddev>1.7e-2</stddev>
		    <bias_mean>0.1</bias_mean>
		    <bias_stddev>0.001</bias_stddev>
		  </noise>
		</y>
		<z>
		  <noise type="gaussian">
		    <mean>0.0</mean>
		    <stddev>1.7e-2</stddev>
		    <bias_mean>0.1</bias_mean>
		    <bias_stddev>0.001</bias_stddev>
		  </noise>
		</z>
	      </linear_acceleration>
	    </imu>
	  </sensor>
    </link>
    
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
      <pose>0.45 0 0.5 0 0 0</pose>
    </joint>

    <plugin 
    	filename="libignition-gazebo-joint-state-publisher-system.so"
    	name="ignition::gazebo::systems::JointStatePublisher">
	    	<topic>/joint_states</topic>
    </plugin> 
    
    <plugin
	  filename="libignition-gazebo-imu-system.so"
	  name="ignition::gazebo::systems::Imu">
    </plugin>
    
    <plugin filename="libignition-gazebo-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
   
	<left_joint>front_left_wheel_joint</left_joint>
	<left_joint>rear_left_wheel_joint</left_joint>
	<right_joint>front_right_wheel_joint</right_joint>
	<right_joint>rear_right_wheel_joint</right_joint>
	
	<wheel_separation>0.4</wheel_separation>
	<wheel_radius>0.165</wheel_radius>
	
	<!-- input -->
	<topic>/cmd_vel</topic>
	
	<!-- output -->
	<odom_topic>/odom</odom_topic>
	<tf_topic>/tf</tf_topic>
	<frame_id>odom</frame_id>
	<child_frame_id>base_link</child_frame_id>
	<odom_publish_frequency>30</odom_publish_frequency>
	<publish_tf>true</publish_tf>
	
    </plugin>

  </model>
  
</sdf>

