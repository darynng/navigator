<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="robot">

    <!-- ================= BASE LINK ================= -->
    <link name="base_link">
      <pose>0 0 0.125 0 0 0</pose>

      <visual name="base_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.95 0.35 0.2</size>
          </box>
        </geometry>
        <material>
          <ambient>0.278 0.294 0.549 0.5</ambient>
          <diffuse>0.278 0.294 0.549 0.5</diffuse>
        </material>
      </visual>

      <collision name="base_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.7 0.55 0.2</size>
          </box>
        </geometry>
      </collision>

      <inertial>
        <mass>60</mass>
        <inertia>
          <ixx>1.7125</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>2.65</iyy>
          <iyz>0</iyz>
          <izz>3.9625</izz>
        </inertia>
      </inertial>
    </link>

    <!-- ================= WHEELS ================= -->
    <!-- Front Left Wheel -->
    <link name="front_left_wheel">
      <pose>0.2 -0.35 0 1.5708 0 0</pose>
      <visual name="front_left_visual">
        <geometry>
          <cylinder>
            <radius>0.165</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
      </visual>
      <collision name="front_left_collision">
        <geometry>
          <cylinder>
            <radius>0.165</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
      </collision>
      <inertial>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.02131875</ixx>
          <iyy>0.02131875</iyy>
          <izz>0.0408375</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="front_left_wheel_joint" type="fixed">
      <pose>0.2 -0.35 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>front_left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <!-- Front Right Wheel -->
    <link name="front_right_wheel">
      <pose>0.2 0.35 0 1.5708 0 0</pose>
      <visual name="front_right_visual">
        <geometry>
          <cylinder>
            <radius>0.165</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
      </visual>
      <collision name="front_right_collision">
        <geometry>
          <cylinder>
            <radius>0.165</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
      </collision>
      <inertial>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.02131875</ixx>
          <iyy>0.02131875</iyy>
          <izz>0.0408375</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="front_right_wheel_joint" type="fixed">
      <pose>0.2 0.35 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <!-- Rear Left Wheel -->
    <link name="rear_left_wheel">
      <pose>-0.2 -0.35 0 1.5708 0 0</pose>
      <visual name="rear_left_visual">
        <geometry>
          <cylinder>
            <radius>0.165</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
      </visual>
      <collision name="rear_left_collision">
        <geometry>
          <cylinder>
            <radius>0.165</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
      </collision>
      <inertial>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.02131875</ixx>
          <iyy>0.02131875</iyy>
          <izz>0.0408375</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="rear_left_wheel_joint" type="fixed">
      <pose>-0.2 -0.35 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>rear_left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <!-- Rear Right Wheel -->
    <link name="rear_right_wheel">
      <pose>-0.2 0.35 0 1.5708 0 0</pose>
      <visual name="rear_right_visual">
        <geometry>
          <cylinder>
            <radius>0.165</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
      </visual>
      <collision name="rear_right_collision">
        <geometry>
          <cylinder>
            <radius>0.165</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
      </collision>
      <inertial>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.02131875</ixx>
          <iyy>0.02131875</iyy>
          <izz>0.0408375</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="rear_right_wheel_joint" type="fixed">
      <pose>-0.2 0.35 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>rear_right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <!-- ================= CAMERA ================= -->
    <link name="camera_link">
      <pose>0.45 0 0.125 0 0 0</pose>

      <visual name="camera_visual">
        <geometry>
          <box>
            <size>0.1 0.2 0.03</size>
          </box>
        </geometry>
      </visual>

      <collision name="camera_collision">
        <geometry>
          <box>
            <size>0.1 0.2 0.03</size>
          </box>
        </geometry>
      </collision>

      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.000375</ixx>
          <iyy>0.0003075</iyy>
          <izz>0.0003075</izz>
        </inertia>
      </inertial>
      
      <!-- DEPTH -->
      <sensor name="d435i_depth" type="depth_camera">
        <pose>0 0 0 0 0 0</pose>
        <topic>depth_camera</topic>
        <gz_frame_id>depth_camera_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>90</update_rate>
        <visualize>0</visualize>
 
        <camera name="d435i">
		<horizontal_fov>1.3962634</horizontal_fov>
		<image>
			<width>1280</width>
			<height>720</height>
		</image>
		<clip>
			 <near>0.1</near>
			 <far>100</far>
		</clip>
		<noise>
			 <type>gaussian</type>
			 <mean>0</mean>
			 <stddev>0.1</stddev>
		</noise>
        </camera>
      </sensor>
      
      <!-- COLOR -->
      <sensor name="d435i_color" type="camera">
	<always_on>1</always_on>
	<update_rate>30</update_rate>
	<visualize>1</visualize>
	<pose>0 0.0175 0.5125 0 -0 0</pose>
	<topic>color_camera</topic>
		
	<camera name="d435i">
		<horizontal_fov>1.21126</horizontal_fov>
		<image>
			<width>640</width>
			<height>480</height>
			<format>RGB_INT8</format>
		</image>
		<clip>
			<near>0.1</near>
			<far>100</far>
		</clip>
		<noise>
			<type>gaussian</type>
			<mean>0</mean>
			<stddev>0.007</stddev>
		</noise>
	</camera>
       </sensor>

       <!-- INFRARED -->
       <sensor name='d435i_ired1' type='camera'>
        <camera name='d435i'>
          <horizontal_fov>1.48702</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>L_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.05</stddev>
          </noise>
        </camera>
        <always_on>1</always_on>
        <update_rate>90</update_rate>
        <visualize>0</visualize>
        <pose>0 0.0175 0.5125 0 -0 0</pose>
      </sensor>
      
      <sensor name='d435i_ired2' type='camera'>
        <camera name='d435i'>
          <horizontal_fov>1.48702</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>L_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.05</stddev>
          </noise>
        </camera>
        <always_on>1</always_on>
        <update_rate>90</update_rate>
        <visualize>0</visualize>
        <pose>0 0.0175 0.5125 0 -0 0</pose>
      </sensor>
      
    </link>
    
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
      <pose>0.45 0 0.125 0 0 0</pose>
    </joint>

    <!-- Camera optical frame -->
    
    <link name="camera_link_optical"/>
    
    <joint name="camera_optical_joint" type="fixed">
      <parent>camera_link</parent>
      <child>camera_link_optical</child>
      <pose>0 0 0 -1.571 0 -1.571</pose>
    </joint>
    
    <!-- joint state publisher plugin -->
    <plugin filename="libignition-gazebo-joint-state-publisher-system.so" name="ignition::gazebo::systems::JointStatePublisher"/>

  </model>
</sdf>
